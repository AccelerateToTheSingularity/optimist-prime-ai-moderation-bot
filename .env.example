# Copy this file to .env and enter credentials and settings for your own bot.
# Never commit .env. Keep Safe Mode enabled while reviewing a new installation.

# Reddit app credentials. Use a Reddit account and app that you control.
REDDIT_CLIENT_ID=replace_with_your_client_id
REDDIT_CLIENT_SECRET=replace_with_your_client_secret
REDDIT_REFRESH_TOKEN=replace_with_your_refresh_token
REDDIT_OAUTH_SCOPES=identity read
REDDIT_DEVELOPER_USERNAME=your_reddit_account_name
BOT_EXPECTED_USERNAME=your_bot_account_name
BOT_SUBREDDIT=

# Select a supported text provider and a model it currently offers.
BOT_LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# OPENAI_BASE_URL=https://your-provider.example/v1
# Structured-decision features use the OpenRouter Decisions API.
# OPENROUTER_API_KEY=

# Safe starting point: features and moderation actions remain disabled.
BOT_SAFE_MODE=true
BOT_POST_TLDR_ENABLED=false
BOT_COMMENT_TLDR_ENABLED=false
BOT_COMMENT_SUMMARY_ENABLED=false
BOT_REDDIT_REFERENCE_TLDR_ENABLED=false
BOT_CONVERSATIONAL_REPLIES_ENABLED=false
BOT_ENGAGEMENT_ACTION_MODE=log
BOT_INBOX_REPLIES_ENABLED=false
BOT_SUMMONS_ENABLED=false
BOT_CONTENT_MODERATION_ENABLED=false
BOT_REPORTED_USER_REVIEW_ENABLED=false
BOT_AUTOMATED_BAN_ENABLED=false
# Required only if you enable a history-review route. Choose your own cutoff.
BOT_HISTORY_REVIEW_MATCH_THRESHOLD_PERCENT=
# Required only if you enable a history-review route. Choose the history window.
BOT_HISTORY_REVIEW_LOOKBACK_DAYS=
# Required only if you enable a history-review route. Choose the maximum amount
# of public history that may be sent to the AI provider (1-250 items).
BOT_HISTORY_REVIEW_MAX_ITEMS=
# Leave blank to keep history-based bans disabled.
BOT_HISTORY_REVIEW_BAN_THRESHOLD_PERCENT=
BOT_MODMAIL_ASSISTANT_ENABLED=false
BOT_CROSSPOST_ENABLED=false
BOT_USER_CUSTOM_FLAIR_ENABLED=false

# Optional policy inputs. Supply rules and criteria you wrote for your own
# community before enabling content or history review.
# BOT_MODERATION_RULES_FILE=data/rules.json
# BOT_HISTORY_CRITERIA_FILE=data/history_criteria.json
# BOT_CROSSPOST_SELECTION_GUIDANCE=Describe your own criteria for selecting posts.
# Required if crossposting is enabled; choose your own match cutoff (1-100).
# BOT_CROSSPOST_SELECTION_THRESHOLD_PERCENT=
# BOT_CROSSPOST_SOURCE_SUB=your_source_subreddit
# BOT_CROSSPOST_TARGET_SUB=your_target_subreddit
# Crossposting also requires values you choose for its rate, age, schedule,
# and duplicate-search limits. Empty values keep it unavailable.
# BOT_CROSSPOST_MAX_PER_DAY=
# BOT_CROSSPOST_MIN_HOURS_OLD=
# BOT_CROSSPOST_MAX_HOURS_OLD=
# BOT_CROSSPOST_EARLIEST_HOUR_UTC=
# BOT_CROSSPOST_LATEST_HOUR_UTC=
# BOT_CROSSPOST_LOOKBACK_DAYS=
# BOT_USER_CUSTOM_FLAIR_ALLOWED_VALUES=Example flair one,Example flair two

# Optional local paths for runtime files that should stay out of Git.
# BOT_RUNTIME_STATE_FILE=data/bot_state.json
# BOT_RUNTIME_STATS_FILE=data/stats.json
# BOT_RUNTIME_AUDIT_LOG_FILE=data/audit_log.json
# BOT_LOG_DIR=data/logs
